generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  mobile       String   @unique
  age          Int
  sex          String
  passwordHash String
  createdAt    DateTime @default(now())
}
